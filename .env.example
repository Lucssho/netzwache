# =====================================================================
#  NETZWACHE - Konfiguration
#  Diese Datei nach ".env" kopieren und anpassen.
#  Ohne jede Anpassung laufen bereits: Bluesky, Reddit, Google News und
#  alle News-Feeds.
# =====================================================================

# ---------- Allgemein ------------------------------------------------
LOG_LEVEL=INFO
TICK_SECONDS=10                 # Haupt-Takt der Sammelschleife
MAX_ITEMS_PER_RUN=50
RETENTION_DAYS=30               # Posts älter als X Tage werden gelöscht
CORS_ORIGINS=*

# ---------- Intervalle je Quelle (Sekunden) --------------------------
INTERVAL_BLUESKY=300
INTERVAL_REDDIT=120
INTERVAL_X=60
INTERVAL_FACEBOOK=300
INTERVAL_NEWS=120
INTERVAL_GOOGLENEWS=60

# ---------- Bluesky (AT Protocol) ------------------------------------
# Funktioniert auch komplett leer (anonyme öffentliche Suche).
# Für stabilere Limits: App-Passwort unter bsky.app -> Einstellungen ->
# "App-Passwörter" erzeugen. NIEMALS das Hauptpasswort eintragen.
BLUESKY_HANDLE=moowastaken.bsky.social
BLUESKY_APP_PASSWORD=axhq-sgvp-souy-hj26

# ---------- Reddit ----------------------------------------------------
# Leer = öffentliche JSON-API. Für stabile Limits eine App vom Typ
# "script" unter https://www.reddit.com/prefs/apps anlegen.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=netsec,cybersecurity,linux,de_EDV,technology,programming,news

# ---------- X / Twitter ------------------------------------------------
# X hat keine kostenlose Lese-API mehr. Eine der beiden Optionen wählen:
#   a) offizieller Bearer-Token (kostenpflichtig, developer.x.com)
X_BEARER_TOKEN=
#   b) Nitter-Mirror(s), kommagetrennt - kostenlos, aber unzuverlässig
NITTER_INSTANCES=

# ---------- Facebook ---------------------------------------------------
# Nur legal über die Graph API für Seiten, die du selbst verwaltest.
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_IDS=
# Alternative: eigene RSS-Bridge-Instanz
RSSBRIDGE_URL=

# ---------- News-Feeds --------------------------------------------------
# true = kuratierte Feeds auch ohne Suchbegriff-Treffer übernehmen
NEWS_KEEP_ALL=true

# ---------- Google News --------------------------------------------------
# Öffentliche RSS-Suche, kein Key nötig. Läuft pro aktivem Suchbegriff.
